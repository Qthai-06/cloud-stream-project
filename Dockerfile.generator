FROM python:3.10-slim
WORKDIR /app

# Cài đặt thư viện cần thiết cho generator (không cần pyspark nặng 317MB)
RUN pip install --no-cache-dir kafka-python==2.0.2 pyyaml==6.0.1

# Copy toàn bộ mã nguồn và cấu hình
COPY src/ /app/src/
COPY configs/ /app/configs/

# Tạo non-root user để giảm attack surface (bảo mật container)
RUN useradd --uid 1002 --no-create-home --shell /bin/false generator && \
    mkdir -p /app/logs && \
    chown -R generator:generator /app

# Thiết lập PYTHONPATH để import không bị lỗi
ENV PYTHONPATH=/app

# Chuyển sang non-root user trước khi khởi chạy
USER generator

CMD ["python", "src/generator/event_producer.py"]
